# Summary:
# Copy this file to ".env" for local development if using the live Vision API.
# Note: The frontend application works 100% standalone using our built-in
# 4-Stage DSA Pipeline even without an external API key configured.

# Optional API key for server-side leaf vision analysis (/api/detect-pest)
GEMINI_API_KEY="YOUR_API_KEY_HERE"

# Server port for Express backend (defaults to 3000)
PORT="3000"
